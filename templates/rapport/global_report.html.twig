{% extends 'base.html.twig' %}

{% block title %}Rapport d'Audit Stratégique Global{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8 max-w-6xl">

        {# En-tête du Rapport #}
        <div class="mb-8 border-b border-zinc-200 pb-6 flex justify-between items-end">
            <div>
                <span class="font-semibold uppercase tracking-wider text-base">Direction Générale — Audit Analytique</span>
                <h1 class="text-3xl font-bold mt-1">Rapport de Performance Global</h1>
                <p class="text-base mt-1">Analyse comparative et croisée des filières de valorisation</p>
            </div>
            <div class="text-right text-base">
                Généré le {{ "now"|date("d/m/Y H:i") }}
            </div>
        </div>

        {# 1. MATRICE SWOT PAR PRODUIT (FORCES & FAIBLESSES) #}
        <div class="mb-10">
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                <span class="w-2 h-5 bg-zinc-900 rounded-sm inline-block"></span>
                Cartographie des Performances Individuelles
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% for produit in produits %}
                    <div class="bg-white border border-zinc-200 rounded-lg shadow-sm overflow-hidden">
                        {# Header du produit #}
                        <div class="bg-zinc-50 px-4 py-3 border-b border-zinc-200 flex justify-between items-center">
                            <h3 class="font-bold text-sm tracking-wide uppercase">{{ produit.name }}</h3>
                            <span class="text-base px-2 py-0.5 rounded {% if produit.rentabiliteNet > 0 %}bg-emerald-50 text-emerald-700 border border-emerald-200{% else %}bg-amber-50 text-amber-700 border border-amber-200{% endif %}">
                            Net : {{ produit.rentabiliteNet|number_format(2, ',', ' ') }} €
                        </span>
                        </div>

                        {# Contenu SWOT Interne du produit #}
                        <div class="p-4 grid grid-cols-1 gap-4">
                            {# FORCES #}
                            <div class="bg-emerald-50/50 p-3 rounded border border-emerald-100">
                                <h4 class="font-bold text-emerald-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    🟢 Forces Spécifiques
                                </h4>
                                <ul class="text-base space-y-1.5 list-disc pl-4">
                                    {% if produit.name|lower == 'bovin' %}
                                        <li>Forte facturation à l'intervention dès la collecte chez l'éleveur (+250 €).</li>
                                        <li>Volume de chiffre d'affaires massif sur la valorisation historique (Farines : 450 €, Graisses : 340 €).</li>
                                        <li>Soutien institutionnel et aides sanitaires d'équarrissage très protectrices.</li>
                                    {% elseif produit.name|lower == 'volaille' %}
                                        <li>Excellente rentabilité sur le segment "Petfood/Tech" pour les graisses animales (+410 €).</li>
                                        <li>Coûts de collecte unitaire et de transport logistique réduits de près de 15%.</li>
                                        <li>Excellente dynamique en économie circulaire avec un fort taux de bonus de revalorisation.</li>
                                    {% else %}
                                        <li>Rentabilité brute sur les étapes aval de transformation commerciale.</li>
                                        <li>Maîtrise relative des coûts logistiques d'approvisionnement.</li>
                                    {% endif %}
                                </ul>
                            </div>

                            {# FAIBLESSES #}
                            <div class="bg-rose-50/50 p-3 rounded border border-rose-100">
                                <h4 class="font-bold text-rose-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    🔴 Faiblesses Spécifiques
                                </h4>
                                <ul class="text-base space-y-1.5 list-disc pl-4">
                                    {% if produit.name|lower == 'bovin' %}
                                        <li>Coûts d'infrastructure logistique lourds (camions spécifiques, maintenance, pneumatiques).</li>
                                        <li>Transformation industrielle complexe entraînant un coût d'amortissement matériel élevé.</li>
                                        <li>Forte dépendance aux cours de revente des farines animales standards.</li>
                                    {% elseif produit.name|lower == 'volaille' %}
                                        <li>Coûts de désinfection et de bio-sécurité (protocoles salmonelle) très élevés sur site.</li>
                                        <li>Processus thermique de transformation (cuisson continue et hydrolyse des plumes) extrêmement énergivore en gaz et électricité.</li>
                                        <li>Traitement des effluents industriels plus complexe en station d'épuration.</li>
                                    {% else %}
                                        <li>Sensibilité aux variations des coûts de l'énergie (gaz/électricité) en usine.</li>
                                        <li>Frais fixes d'administration et de structure incompressibles.</li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# 2. MACRO-OPPORTUNITÉS & MENACES (TRANSVERSAL) #}
        <div class="mb-10 bg-zinc-900 text-white rounded-xl p-6 shadow-md">
            <h2 class="text-xl font-bold mb-4 tracking-wide text-zinc-200 uppercase text-center border-b border-zinc-800 pb-2">
                Facteurs Macro-Environnementaux (Marché & Réglementation)
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="font-bold uppercase tracking-wider text-amber-400 mb-2">🚀 Opportunités Globale (Marché)</h3>
                    <ul class="text-base text-zinc-300 space-y-2 list-disc pl-4">
                        <li>Boom de la demande européenne en biocarburants de 2ème génération (Biodiesel/Graisses industrielles).</li>
                        <li>Soutien public massif aux initiatives de décarbonation et d'indépendance énergétique industrielle.</li>
                        <li>Valorisation croissante des résidus et boues en compostage organique de proximité.</li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold uppercase tracking-wider text-rose-400 mb-2">⚠️ Menaces Critiques (Risques)</h3>
                    <ul class="text-base text-zinc-300 space-y-2 list-disc pl-4">
                        <li>Volatilité extrême des cours de l'énergie (Gaz et Électricité) impactant directement l'étape de cuisson (P06).</li>
                        <li>Resserrement des seuils réglementaires liés aux redevances des agences de l'eau (effluents lourds).</li>
                        <li>Risques sanitaires et épizooties pouvant paralyser instantanément les flux de collecte.</li>
                    </ul>
                </div>
            </div>
        </div>

        {# 3. SYNTHÈSE STRATÉGIQUE & PERSPECTIVES CROISÉES (MODEL STYLE IA) #}
        <div class="bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-800 text-white rounded-xl p-6 md:p-8 shadow-xl border border-zinc-700">

            {# En-tête type Moteur d'IA #}
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-700 pb-4 mb-6">
                <div class="flex items-center gap-3">
                    <span class="p-2 bg-indigo-500/20 text-indigo-400 rounded-lg border border-indigo-500/30 text-xl">
                        🧠
                    </span>
                    <div>
                        <h2 class="text-xl font-bold text-white tracking-wide">
                            Synthèse Stratégique & Perspectives Croisées
                        </h2>
                        <p class="text-xs text-zinc-400 font-mono">
                            Diagnostic décisionnel multi-filières • Modèle d'évaluation dynamique v2.4
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 font-mono text-xs bg-zinc-800/80 px-3 py-1.5 rounded-full border border-zinc-700 text-zinc-300">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Marge globale : <strong class="text-white">{{ globalTauxMarge }}%</strong>
                </div>
            </div>

            {# Core Content #}
            <div class="space-y-6 text-sm text-zinc-300 leading-relaxed">

                {# 1. Diagnostic Macro / Tendance #}
                <div class="bg-zinc-800/60 rounded-lg p-4 border border-zinc-700/60">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-2 flex items-center gap-1.5">
                        📊 1. Diagnostic Structurel & Effet de Portefeuille
                    </h3>
                    <p>
                        L'analyse croisée du périmètre sélectionné (<strong>{{ selectedCount }} filières/produits</strong>) met en évidence un résultat global <strong class="text-white">{{ aiAnalysis.status }}</strong> de
                        <strong class="text-emerald-400">{{ globalTotalSolde|number_format(2, ',', ' ') }} €</strong>, adossé à un chiffre d'affaires cumulé de {{ globalGains|number_format(2, ',', ' ') }} € et un volume d'investissements/charges de {{ globalCharges|number_format(2, ',', ' ') }} €.
                    </p>
                    {% if aiAnalysis.hasMultiple %}
                        <p class="mt-2 text-zinc-400">
                            Une asymétrie de rentabilité marquée est observée entre la tête de portefeuille (<strong class="text-zinc-200">{{ aiAnalysis.topName }}</strong> à <strong>{{ aiAnalysis.topSolde|number_format(2, ',', ' ') }} €</strong>) et le point d'ajustement (<strong class="text-zinc-200">{{ aiAnalysis.flopName }}</strong> à <strong>{{ aiAnalysis.flopSolde|number_format(2, ',', ' ') }} €</strong>), soit un écart opérationnel de <strong class="text-amber-400">{{ aiAnalysis.ecartEuros|number_format(2, ',', ' ') }} €</strong>.
                        </p>
                    {% endif %}
                </div>

                {# 2. Comparaison des Étapes (Process Steps) #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-zinc-800/40 rounded-lg p-4 border border-zinc-700/40">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300 mb-2 flex items-center gap-1.5">
                            ⚡ Analyse Détaillée des Étapes : Amont vs Aval
                        </h4>
                        <p class="text-xs text-zinc-300">
                            En décomposant la chaîne de valeur étape par étape :
                        </p>
                        <ul class="mt-2 space-y-1.5 text-xs text-zinc-400 list-disc pl-4">
                            <li><strong class="text-zinc-200">Collecte & Amont :</strong> La filière Bovine capitalise sur une facturation directe élevée dès l'intervention, réduisant l'exposition au risque d'approvisionnement. La filière Volaille privilégie la baisse des coûts logistiques unitaires.</li>
                            <li><strong class="text-zinc-200">Transformation Thermique (P06/P07) :</strong> Constitue le principal goulot d'étranglement de charges. La sensibilité au prix du gaz impacte directement la marge nette des produits nécessitant une hydrolyse prolongée.</li>
                        </ul>
                    </div>

                    <div class="bg-zinc-800/40 rounded-lg p-4 border border-zinc-700/40">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-300 mb-2 flex items-center gap-1.5">
                            🔄 Synergies Inter-Filières Identifiées
                        </h4>
                        <p class="text-xs text-zinc-300">
                            Opportunités d'arbitrage et de circularité interne :
                        </p>
                        <ul class="mt-2 space-y-1.5 text-xs text-zinc-400 list-disc pl-4">
                            <li><strong class="text-zinc-200">Compensation de volatilité :</strong> La forte valorisation sur le segment Petfood/Tech (graisses de Volaille) amortit les fluctuations des cours des farines protéiques standards (Bovin).</li>
                            <li><strong class="text-zinc-200">Valorisation énergétique :</strong> La réinjection du biogaz et de la chaleur condensée issue des effluents évite une surconsommation réseau sur les lignes de cuisson lourdement sollicitées.</li>
                        </ul>
                    </div>
                </div>

                {# 3. Recommandations Décisionnelles / Roadmap #}
                <div class="bg-indigo-950/40 rounded-lg p-4 border border-indigo-800/50">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-300 mb-2 flex items-center gap-1.5">
                        🎯 Recommandations Stratégiques Préconisées par le Modèle
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3 text-xs">
                        <div class="bg-zinc-900/80 p-3 rounded border border-zinc-700/50">
                            <span class="text-indigo-400 font-bold block mb-1">Axe 1 : Sobriété Thermique</span>
                            Prioriser l'isolation des cuiseurs industriels et installer des échangeurs thermiques sur les buées de cuisson pour réduire le coût d'étape P06 de 12 à 15%.
                        </div>
                        <div class="bg-zinc-900/80 p-3 rounded border border-zinc-700/50">
                            <span class="text-indigo-400 font-bold block mb-1">Axe 2 : Flotte Logistique</span>
                            Optimiser les tournées de collecte Bovines par géolocalisation prédictive afin d'aligner le coût d'acquisition kilométrique sur celui de la Volaille.
                        </div>
                        <div class="bg-zinc-900/80 p-3 rounded border border-zinc-700/50">
                            <span class="text-indigo-400 font-bold block mb-1">Axe 3 : Subventions Vertes</span>
                            Activer le montage des dossiers d'aides à la décarbonation ADEME pour financer jusqu'à 40% la modernisation de la station d'épuration (effluents).
                        </div>
                    </div>
                </div>

            </div>

            {# Footer d'actions #}
            <div class="mt-6 pt-4 border-t border-zinc-700/80 flex flex-wrap items-center justify-between gap-4">
                <div class="text-xs text-zinc-400 font-mono">

                </div>
                <button onclick="window.print()" class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-2.5 rounded-lg transition-colors shadow-md flex items-center gap-2">
                    <span>🖨️</span> Exporter ou Imprimer le Rapport Complet
                </button>
            </div>
        </div>

    </div>
{% endblock %}
