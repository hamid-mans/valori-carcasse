{% extends 'base.html.twig' %}

{% block title %}Sessions d'Équarrissage - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Sessions d'Équarrissage</h1>
            <p class="text-xs text-zinc-500 mt-1">Consultez, analysez et pilotez l'historique complet de vos sessions de traitement.</p>
        </div>
        <a href="{{ path('app_processus_new') }}" class="inline-flex items-center justify-center gap-2 px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span>Nouvelle Session</span>
        </a>
    </div>

    <!-- TABLEAU COMPTABLE DES SESSIONS -->
    <div class="bg-white border border-zinc-200 rounded-md overflow-hidden">
        {% if processuses is defined and processuses is not empty %}
            <table class="table w-full text-xs">
                <thead>
                <tr class="bg-zinc-50 border-b border-zinc-200 text-zinc-500 uppercase tracking-wider text-[10px] font-semibold">
                    <th class="py-3 px-4 text-left">Désignation Session</th>
                    <th class="py-3 px-4 text-left">Matière / Produit</th>
                    <th class="py-3 px-4 text-left">Date d'enregistrement</th>
                    <th class="py-3 px-4 text-center">Nombre d'étapes</th>
                    <th class="py-3 px-4 text-right">Marge Net / Solde</th>
                    <th class="py-3 px-4 text-right">Actions</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                {% for processus in processuses %}
                    <tr class="hover:bg-zinc-50/50 transition-colors">
                        <td class="py-3.5 px-4 font-bold text-zinc-900 text-sm tracking-tight">
                            {{ processus.name }}
                        </td>
                        <td class="py-3.5 px-4">
                      <span class="inline-block bg-zinc-100 text-zinc-800 text-[10px] font-mono tracking-wide uppercase px-2 py-0.5 rounded border border-zinc-200">
                         {{ processus.product.name }}
                      </span>
                        </td>
                        <td class="py-3.5 px-4 text-zinc-500 font-mono">
                            {{ processus.createdAt|date('d/m/Y H:i') }}
                        </td>
                        <td class="py-3.5 px-4 text-center font-mono text-zinc-600">
                            {{ processus.steps|length }}
                        </td>
                        <td class="py-3.5 px-4 text-right font-mono font-bold tracking-tight {% if processus.soldeFinal >= 0 %}text-zinc-900{% else %}text-rose-600{% endif %}">
                            {{ processus.soldeFinal|number_format(2, ',', ' ') }} €
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="inline-flex items-center gap-2">
                                <a href="{{ path('app_processus_show', {'id': processus.id}) }}" class="inline-flex items-center justify-center gap-1 px-2 py-1 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
                                    Visualiser
                                </a>
                                <a href="{{ path('app_processus_edit', {'id': processus.id}) }}" class="inline-flex items-center justify-center px-2 py-1 border border-transparent bg-zinc-100 text-zinc-700 hover:bg-zinc-200 font-medium rounded-md text-xs transition-colors">
                                    Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <!-- ÉTAT VIDE TECHNIQUE -->
            <div class="text-center py-16 border-dashed border-2 border-zinc-100 m-4 rounded-md">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-10 h-10 text-zinc-300 mx-auto mb-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.25 2.25 0 0 1 10.5 2.25h4.5a2.25 2.25 0 0 1 2.246 2.008M3.75 18.75V6.375c0-.621.504-1.125 1.125-1.125h2.25M3.75 18.75A2.25 2.25 0 0 0 6 21h12a2.25 2.25 0 0 0 2.25-2.25M3.75 18.75V16.5m1.875-12h1.5a.375.375 0 0 1 .375.375v1.5a.375.375 0 0 1-.375.375h-1.5a.375.375 0 0 1-.375-.375v-1.5a.375.375 0 0 1 .375-.375Z" />
                </svg>
                <p class="text-xs font-medium text-zinc-500 italic">Aucune session d'équarrissage enregistrée.</p>
                <a href="{{ path('app_processus_new') }}" class="inline-flex items-center justify-center mt-4 px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
                    Initialiser une session
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}