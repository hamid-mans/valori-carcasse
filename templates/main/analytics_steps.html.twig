{% extends 'base.html.twig' %}

{% block title %}Analyse comparative des étapes - Valori-Carcasse{% endblock %}

{% block body %}
	<!-- ENTÊTE TECHNIQUE DE L'OUTIL ANALYTIQUE -->
	<div class="mb-6">
		<h1 class="text-2xl font-bold tracking-tight text-zinc-900">Analyse Comparative des Flux</h1>
		<p class="text-xs text-zinc-500 mt-1">Confrontez les lignes financières (ex: Transport, Abattage, Carburant) de plusieurs matières simultanément.</p>
	</div>

	<!-- BLOC DES CRITÈRES ET FILTRES DE CONFRONTATION -->
	<div class="bg-white border border-zinc-200 rounded-md p-5 mb-6">
		<form method="get" action="{{ path('app_analytics_steps') }}" class="space-y-4">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

				<!-- MOT-CLÉ RECHERCHÉ -->
				<div class="space-y-1 lg:col-span-1">
					<label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">1. Étape recherchée</label>
					<input type="text" name="search" value="{{ currentSearch }}" placeholder="Ex: 'Transport', 'Essence'..." class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-400 transition-colors">
				</div>

				<!-- SÉLECTION MULTIPLE DES MATIÈRES / BENCHMARK -->
				<div class="space-y-1 lg:col-span-2">
					<label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">2. Produits à inclure dans le benchmark</label>
					<div class="flex flex-wrap gap-x-4 gap-y-2 bg-zinc-50 p-3 rounded-md border border-zinc-200 min-h-[38px] items-center">
						{% for p in products %}
							<label class="inline-flex items-center gap-2 cursor-pointer select-none">
								<input type="checkbox" name="product_ids[]" value="{{ p.id }}"
								       {% if p.id in currentProductIds %}checked{% endif %}
								       class="rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900 h-3.5 w-3.5 accent-zinc-900">
								<span class="text-xs font-bold text-zinc-700 uppercase font-mono tracking-tight">{{ p.name }}</span>
							</label>
						{% endfor %}
					</div>
				</div>
			</div>

			<!-- BARRE D'ACTIONS TECHNIQUE -->
			<div class="flex justify-end gap-2 border-t border-zinc-100 pt-4 mt-2">
				<a href="{{ path('app_analytics_steps') }}" class="inline-flex items-center justify-center px-3 py-1.5 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
					Réinitialiser
				</a>
				<button type="submit" class="inline-flex items-center justify-center px-4 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
					Lancer la confrontation
				</button>
			</div>
		</form>
	</div>

	<!-- ZONE DE RENDU DES LIGNES ET RÉSULTATS -->
	<div class="bg-white border border-zinc-200 rounded-md p-5">
		{% if stepsData is not empty %}
			<div class="flex justify-between items-center mb-4 border-b border-zinc-100 pb-2">
				<h3 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400">Lignes correspondantes trouvées</h3>
				<span class="inline-block font-mono text-[10px] font-bold text-zinc-900 bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded">
                {{ stepsData|length }} ligne(s)
             </span>
			</div>

			<div class="overflow-x-auto">
				<table class="table w-full text-xs">
					<thead>
					<tr class="text-zinc-500 uppercase tracking-wider text-[10px] font-semibold border-b border-zinc-100">
						<th class="pb-2 text-left">Matière / Produit</th>
						<th class="pb-2 text-left">Processus / Session</th>
						<th class="pb-2 text-left">Libellé de l'Étape</th>
						<th class="pb-2 text-right">Montant Unitaire</th>
						<th class="pb-2 text-center w-36">Nature de l'impact</th>
					</tr>
					</thead>
					<tbody class="divide-y divide-zinc-100">
					{% for data in stepsData %}
						<tr class="hover:bg-zinc-50/50 transition-colors">
							<td class="py-3 font-bold text-zinc-900 uppercase font-mono tracking-tight text-sm">
								{{ data.product }}
							</td>
							<td class="py-3 text-zinc-500 font-medium">{{ data.processus }}</td>
							<td class="py-3 font-semibold text-zinc-800">{{ data.step_name }}</td>
							<td class="py-3 text-right font-mono font-bold tracking-tight {% if data.is_gain %}text-emerald-600{% else %}text-rose-600{% endif %}">
								{{ data.amount|number_format(2, ',', ' ') }} €
							</td>
							<td class="py-3 text-center">
								{% if data.is_gain %}
									<span class="inline-block font-mono text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-1.5 py-0.5 rounded tracking-wider">VALORISATION (+)</span>
								{% else %}
									<span class="inline-block font-mono text-[9px] font-bold text-rose-700 bg-rose-50 border border-rose-200/60 px-1.5 py-0.5 rounded tracking-wider">CHARGE (-)</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<!-- ÉTAT VIDE ANALYTIQUE -->
			<div class="flex flex-col items-center justify-center text-center py-12">
				<div class="p-3 bg-zinc-50 rounded-full border border-zinc-100 text-zinc-400 mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>
				<p class="text-xs font-semibold text-zinc-800">Aucun résultat à afficher</p>
				<p class="text-[11px] text-zinc-400 mt-1 max-w-sm leading-relaxed">
					Cochez une ou plusieurs matières et saisissez un mot-clé analytique pour comparer instantanément leurs structures de coûts.
				</p>
			</div>
		{% endif %}
	</div>
{% endblock %}