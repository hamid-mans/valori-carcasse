{% extends 'base.html.twig' %}

{% block title %}Accueil - Catalogue Produits{% endblock %}

{% block body %}
	<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
		<div>
			<h1 class="text-2xl font-bold tracking-tight text-zinc-900">Produits</h1>
			<p class="text-xs text-zinc-500 mt-1">Gérez vos produits ou créez-en un nouveau</p>
		</div>
		<a href="{{ path('app_product_new') }}" class="inline-flex items-center justify-center gap-2 px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
			</svg>
			<span>Nouveau Produit</span>
		</a>
	</div>

	<div class="bg-white border border-zinc-200 rounded-md overflow-hidden">
		{% if products is not empty %}
			<table class="table w-full text-xs">
				<thead>
				<tr class="bg-zinc-50 border-b border-zinc-200 text-zinc-500 uppercase tracking-wider text-[10px] font-semibold">
					<th class="py-3 px-4 text-left">Nom du produit</th>
					<th class="py-3 px-4 text-left">Description / Suivi</th>
					<th class="py-3 px-4 text-center">Sessions actives</th>
					<th class="py-3 px-4 text-right">Actions</th>
				</tr>
				</thead>
				<tbody class="divide-y divide-zinc-100">
				{% for product in products %}
					<tr class="hover:bg-zinc-50/50 transition-colors">
						<td class="py-3.5 px-4 font-bold text-zinc-900 uppercase tracking-tight text-sm">
							{{ product.name }}
						</td>
						<td class="py-3.5 px-4 text-zinc-500 font-normal">
							Suivi d'exploitation, coûts logistiques et valorisation matière.
						</td>
						<td class="py-3.5 px-4 text-center">
                      <span class="inline-block font-mono font-medium text-[10px] text-zinc-600 bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded">
                         {{ product.processuses|length }} session(s)
                      </span>
						</td>
						<td class="py-3.5 px-4 text-right">
							<a href="{{ path('app_product_show', {'id': product.id}) }}" class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
								<span>Détail</span>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
								</svg>
							</a>
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		{% else %}
			<div class="text-center py-16 border-dashed border-2 border-zinc-100 m-4 rounded-md">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-10 h-10 text-zinc-300 mx-auto mb-2">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25" />
				</svg>
				<p class="text-xs font-medium text-zinc-500 italic">Aucun produit configuré pour le moment.</p>
				<a href="{{ path('app_product_new') }}" class="inline-flex items-center justify-center mt-4 px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
					Créer mon premier produit
				</a>
			</div>
		{% endif %}
	</div>
{% endblock %}