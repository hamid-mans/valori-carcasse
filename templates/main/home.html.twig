{% extends 'base.html.twig' %}

{% block title %}Catégories règlementaires{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900 uppercase">Catégories règlementaires</h1>
            <p class="text-xs text-zinc-500 mt-1">Sélectionnez une filière pour consulter ses produits et matières.</p>
        </div>
        <a href="{{ path('app_category_new') }}" class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
            + Ajouter une catégorie
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% for category in categories|sort((a, b) => a.name <=> b.name) %}
            <div class="bg-white p-5 border border-zinc-200 rounded-md flex flex-col justify-between hover:border-zinc-300 transition-all">
                <div>
                    <div class="flex justify-between items-start mb-4">
                        <a href="{{ path('app_category_show', {id: category.id}) }}" class="font-bold text-base text-zinc-900 uppercase tracking-tight">
                            {{ category.name }}
                        </a>
                        <span class="font-mono text-[10px] bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded text-zinc-600 font-semibold">
                            {{ category.products|length }} produit(s)
                        </span>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-zinc-100 mt-2">
                    <a href="{{ path('app_category_show', {id: category.id}) }}" class="flex items-center gap-1 text-xs text-zinc-600 hover:text-zinc-900 font-medium group">
                        <span>Explorer</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>

                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_category_edit', {id: category.id}) }}" class="px-2 py-1 text-[11px] font-medium border border-zinc-200 rounded bg-zinc-50 hover:bg-zinc-100 text-zinc-700 transition-colors">
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_category_delete', {id: category.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                            <button type="submit" class="px-2 py-1 text-[11px] font-medium border border-rose-200 rounded bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-3 bg-white border border-zinc-200 rounded-md p-8 text-center text-xs text-zinc-500">
                Aucune catégorie enregistrée.
            </div>
        {% endfor %}
    </div>
{% endblock %}
