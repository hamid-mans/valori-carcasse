{% extends 'base.html.twig' %}

{% block title %}Comparateur Financier{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-4 py-8">

        <!-- FORMULAIRE DE SÉLECTION MULTI-NIVEAUX (A vs B) -->
        <form method="GET" action="{{ path('app_compare') }}" class="bg-white border border-zinc-200 rounded-md p-5 mb-8 shadow-sm">
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-zinc-100">
                <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-800">Paramètres de Confrontation</h2>
                <a href="{{ path('app_compare') }}" class="text-xs font-mono text-zinc-500 hover:text-zinc-900 underline">Réinitialiser</a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                <!-- FILTRES CÔTÉ A -->
                <div class="bg-zinc-50 p-4 rounded border border-zinc-200 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="bg-zinc-200 text-zinc-800 font-mono tracking-wider uppercase px-2 py-0.5 text-[10px] font-bold rounded-sm">Côté A</span>
                    </div>

                    <!-- Catégorie A -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Catégorie</label>
                        <select name="category_a" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2 focus:ring-1 focus:ring-zinc-900">
                            <option value="">-- Choisir une catégorie --</option>
                            {% for cat in categories %}
                                <option value="{{ cat.id }}" {% if categoryA and categoryA.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Produit A -->
                    {% if categoryA and productsA|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Gamme / Produit</label>
                            <select name="product_a" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Tous les produits de {{ categoryA.name }} --</option>
                                {% for prod in productsA %}
                                    <option value="{{ prod.id }}" {% if productA and productA.id == prod.id %}selected{% endif %}>{{ prod.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <!-- Processus / Session A -->
                    {% if productA and sessionsA|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Session / Processus</label>
                            <select name="session_a" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Toutes les sessions de {{ productA.name }} --</option>
                                {% for sess in sessionsA %}
                                    <option value="{{ sess.id }}" {% if sessionA and sessionA.id == sess.id %}selected{% endif %}>{{ sess.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <!-- Étape A -->
                    {% if sessionA and stepsA|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Étape spécifique</label>
                            <select name="step_a" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Toutes les étapes de {{ sessionA.name }} --</option>
                                {% for st in stepsA %}
                                    <option value="{{ st.id }}" {% if stepA and stepA.id == st.id %}selected{% endif %}>{{ st.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </div>

                <!-- FILTRES CÔTÉ B -->
                <div class="bg-zinc-50 p-4 rounded border border-zinc-200 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="bg-zinc-900 text-white font-mono tracking-wider uppercase px-2 py-0.5 text-[10px] font-bold rounded-sm">Côté B</span>
                    </div>

                    <!-- Catégorie B -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Catégorie</label>
                        <select name="category_b" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2 focus:ring-1 focus:ring-zinc-900">
                            <option value="">-- Choisir une catégorie --</option>
                            {% for cat in categories %}
                                <option value="{{ cat.id }}" {% if categoryB and categoryB.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Produit B -->
                    {% if categoryB and productsB|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Gamme / Produit</label>
                            <select name="product_b" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Tous les produits de {{ categoryB.name }} --</option>
                                {% for prod in productsB %}
                                    <option value="{{ prod.id }}" {% if productB and productB.id == prod.id %}selected{% endif %}>{{ prod.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <!-- Processus / Session B -->
                    {% if productB and sessionsB|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Session / Processus</label>
                            <select name="session_b" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Toutes les sessions de {{ productB.name }} --</option>
                                {% for sess in sessionsB %}
                                    <option value="{{ sess.id }}" {% if sessionB and sessionB.id == sess.id %}selected{% endif %}>{{ sess.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <!-- Étape B -->
                    {% if sessionB and stepsB|length > 0 %}
                        <div>
                            <label class="block text-[11px] font-semibold uppercase text-zinc-500 mb-1">Étape spécifique</label>
                            <select name="step_b" onchange="this.form.submit()" class="w-full text-xs font-mono bg-white border border-zinc-300 rounded p-2">
                                <option value="">-- Toutes les étapes de {{ sessionB.name }} --</option>
                                {% for st in stepsB %}
                                    <option value="{{ st.id }}" {% if stepB and stepB.id == st.id %}selected{% endif %}>{{ st.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </div>

            </div>
        </form>

        <!-- AFFICHAGE DES RÉSULTATS DE COMPARAISON -->
        {% if statsA and statsB %}
            <!-- Badge de précision -->
            <div class="flex justify-between items-center bg-zinc-100 border border-zinc-200 px-4 py-2 rounded-md mb-4 text-xs font-mono">
                <span class="text-zinc-500 uppercase">Niveau d'analyse actuel :</span>
                <span class="font-bold uppercase bg-zinc-900 text-white px-2 py-0.5 rounded">
                 {% if statsA.level == 'category' %}Macro-Catégorie{% elseif statsA.level == 'product' %}Gamme Produit{% elseif statsA.level == 'session' %}Session Complète{% else %}Étape Isolée{% endif %}
            </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
                <!-- BLOC A -->
                <div class="bg-white border border-zinc-200 rounded-md p-5">
                    <div class="flex justify-between items-start border-b border-zinc-100 pb-3 mb-4">
                        <div>
                            <span class="bg-zinc-200 text-zinc-700 font-mono tracking-wider uppercase px-2 py-0.5 text-[10px] rounded-sm">Côté A</span>
                            <h3 class="font-bold text-lg tracking-tight mt-1">{{ statsA.label|upper }}</h3>
                        </div>
                        <div class="text-right">
                            <span class="uppercase font-semibold tracking-wider text-xs text-zinc-500">Solde Cumulé</span>
                            <div class="text-lg font-mono font-bold tracking-tight {% if statsA.solde >= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">
                                {{ statsA.solde|number_format(2, ',', ' ') }} €
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs font-mono">
                        <div class="bg-emerald-50 border border-emerald-100 p-2.5 rounded">
                            <span class="text-emerald-800 text-[10px] block uppercase font-sans">Valorisations</span>
                            <span class="font-bold text-emerald-600">+ {{ statsA.gains|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="bg-rose-50 border border-rose-100 p-2.5 rounded">
                            <span class="text-rose-800 text-[10px] block uppercase font-sans">Charges & Coûts</span>
                            <span class="font-bold text-rose-600">- {{ statsA.costs|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>
                </div>

                <!-- BLOC B -->
                <div class="bg-white border border-zinc-200 rounded-md p-5">
                    <div class="flex justify-between items-start border-b border-zinc-100 pb-3 mb-4">
                        <div>
                            <span class="bg-zinc-900 text-white font-mono tracking-wider uppercase px-2 py-0.5 text-[10px] rounded-sm">Côté B</span>
                            <h3 class="font-bold text-lg tracking-tight mt-1">{{ statsB.label|upper }}</h3>
                        </div>
                        <div class="text-right">
                            <span class="uppercase font-semibold tracking-wider text-xs text-zinc-500">Solde Cumulé</span>
                            <div class="text-lg font-mono font-bold tracking-tight {% if statsB.solde >= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">
                                {{ statsB.solde|number_format(2, ',', ' ') }} €
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs font-mono">
                        <div class="bg-emerald-50 border border-emerald-100 p-2.5 rounded">
                            <span class="text-emerald-800 text-[10px] block uppercase font-sans">Valorisations</span>
                            <span class="font-bold text-emerald-600">+ {{ statsB.gains|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="bg-rose-50 border border-rose-100 p-2.5 rounded">
                            <span class="text-rose-800 text-[10px] block uppercase font-sans">Charges & Coûts</span>
                            <span class="font-bold text-rose-600">- {{ statsB.costs|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AUDIT ET ÉCART DYNAMIQUE -->
            {% set ecartSolde = statsB.solde - statsA.solde %}
            {% set ecartGains = statsB.gains - statsA.gains %}
            {% set ecartCosts = statsB.costs - statsA.costs %}

            <div class="bg-white border border-zinc-200 rounded-md p-5 mb-6">
                <h3 class="font-bold uppercase tracking-wider text-sm border-b border-zinc-100 pb-2 mb-4">Analyse Différentielle (B vs A)</h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-md">
                        <div class="font-semibold uppercase tracking-wider text-xs text-zinc-600">Différence Valorisations</div>
                        <div class="text-lg font-mono font-bold mt-1 {% if ecartGains >= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if ecartGains > 0 %}+{% endif %}{{ ecartGains|number_format(2, ',', ' ') }} €
                        </div>
                    </div>

                    <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-md">
                        <div class="font-semibold uppercase tracking-wider text-xs text-zinc-600">Différence Charges</div>
                        <div class="text-lg font-mono font-bold mt-1 {% if ecartCosts <= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if ecartCosts > 0 %}+{% endif %}{{ ecartCosts|number_format(2, ',', ' ') }} €
                        </div>
                    </div>

                    <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-md">
                        <div class="font-semibold uppercase tracking-wider text-xs text-zinc-600">Écart Net Global</div>
                        <div class="text-lg font-mono font-bold mt-1 {% if ecartSolde >= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if ecartSolde > 0 %}+{% endif %}{{ ecartSolde|number_format(2, ',', ' ') }} €
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUE COMPATIBLE -->
            <div class="bg-white border border-zinc-200 rounded-md p-5">
                <h3 class="font-bold uppercase tracking-widest text-xs mb-4 border-b border-zinc-100 pb-2 text-zinc-700">Visualisation Synthétique</h3>
                <div class="w-full h-64">
                    <canvas id="compareAdvancedChart"></canvas>
                </div>
            </div>

            <script>
                document.addEventListener("turbo:load", function() {
                    const canvasEl = document.getElementById('compareAdvancedChart');
                    if (!canvasEl) return;
                    const ctx = canvasEl.getContext('2d');

                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: ['Gains / Valorisations', 'Coûts / Charges', 'Solde Net'],
                            datasets: [
                                {
                                    label: "{{ statsA.label|e('js') }}",
                                    data: [{{ statsA.gains }}, -{{ statsA.costs }}, {{ statsA.solde }}],
                                    backgroundColor: '#dc2626'
                                },
                                {
                                    label: "{{ statsB.label|e('js') }}",
                                    data: [{{ statsB.gains }}, -{{ statsB.costs }}, {{ statsB.solde }}],
                                    backgroundColor: '#18181b'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: false,
                            scales: {
                                y: { grid: { color: '#f4f4f5' }, ticks: { callback: function(value) { return value + ' €'; } } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                });
            </script>

        {% else %}
            <!-- EN ATTENTE DE SÉLECTION COMPLÈTE -->
            <div class="flex flex-col items-center justify-center text-center py-16 bg-white rounded-md border border-zinc-200 border-dashed">
                <p class="text-xs font-semibold text-zinc-700">Sélectionnez au moins une catégorie du côté A et du côté B pour afficher la confrontation.</p>
            </div>
        {% endif %}

    </div>
{% endblock %}
