{% extends 'base.html.twig' %}

{% block title %}Calcul de Tournée - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto space-y-6">
        <div>
            <h1 class="text-2xl font-bold text-zinc-900">Calculateur de Tournée</h1>
            <p class="text-sm text-zinc-500">Estimez la valeur, le coût et la marge d'une tournée en fonction de sa composition.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-xl border border-zinc-200 shadow-sm md:col-span-1">
                <h2 class="text-sm font-semibold text-zinc-700 mb-4">Composition du lot</h2>
                <form method="POST" data-turbo="false" class="space-y-4">
                    {% for id, info in produits %}
                        <div class="form-control w-full">
                            <label class="label py-1">
                                <span class="label-text-alt font-medium text-zinc-600 uppercase text-[10px] tracking-wider">{{ info.nom }}</span>
                                <span class="label-text-alt text-zinc-400 font-mono">{{ info.valeur|number_format(2, ',', ' ') }} € / Tonne</span>
                            </label>
                            {# CORRECTION ICI : value utilise uniquement saisie[id] #}
                            <input type="number"
                                   name="prod_{{ id }}"
                                   value="{{ saisie[id] }}"
                                   min="0"
                                   class="input input-bordered w-full h-9 text-xs font-mono focus:outline-zinc-900 rounded-md"
                                   placeholder="0" />
                        </div>
                    {% endfor %}

                    <button type="submit" class="inline-flex items-center justify-center w-full px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors mt-2">
                        Calculer la statistique
                    </button>
                </form>
            </div>

            <div class="md:col-span-2 space-y-4">
                {% if resultats is not null %}
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-sm">
                            <span class="text-[10px] uppercase tracking-wider font-semibold text-zinc-400">Valeur Totale</span>
                            <div class="text-xl font-bold text-zinc-900 mt-1">{{ resultats.total_valeur }} €</div>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-sm">
                            <span class="text-[10px] uppercase tracking-wider font-semibold text-zinc-400">Coût Estimé</span>
                            <div class="text-xl font-bold text-zinc-700 mt-1">{{ resultats.total_cout }} €</div>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-sm {% if resultats.marge >= 0 %}bg-emerald-50/50 border-emerald-200{% else %}bg-rose-50/50 border-rose-200{% endif %}">
                            <span class="text-[10px] uppercase tracking-wider font-semibold {% if resultats.marge >= 0 %}text-emerald-600{% else %}text-rose-600{% endif %}">Marge Brute</span>
                            <div class="text-xl font-black {% if resultats.marge >= 0 %}text-emerald-700{% else %}text-rose-700{% endif %} mt-1">{{ resultats.marge }} €</div>
                        </div>
                    </div>

                    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                        <div class="px-5 py-4 border-b border-zinc-100 bg-zinc-50/50">
                            <h3 class="text-xs font-bold tracking-wide text-zinc-700 uppercase">Détail de la simulation</h3>
                        </div>
                        <table class="table w-full text-xs">
                            <thead>
                            <tr class="bg-zinc-50/30 text-zinc-500 border-b border-zinc-100">
                                <th>Produit</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-right">Valeur Unitaire</th>
                                <th class="text-right">Sous-total Valeur</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-100 text-zinc-700">
                            {% for type, qte in saisie %}
                                {% if qte > 0 %}
                                    <tr>
                                        <td class="font-semibold text-zinc-900">{{ produits[type].nom }}</td>
                                        <td class="text-center bg-zinc-50/50 font-bold">{{ qte }}</td>
                                        <td class="text-right">{{ produits[type].valeur }} €</td>
                                        <td class="text-right font-medium">{{ produits[type].valeur * qte }} €</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="bg-zinc-100/50 border-2 border-dashed border-zinc-200 rounded-xl p-12 text-center flex flex-col items-center justify-center h-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-10 h-10 text-zinc-400 mb-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
                        </svg>
                        <span class="text-sm font-medium text-zinc-500">Renseignez des quantités à gauche pour générer les statistiques de la tournée.</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}