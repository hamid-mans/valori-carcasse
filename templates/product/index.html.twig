{% extends 'base.html.twig' %}

{% block title %}Index des Produits - Valori-Carcasse{% endblock %}

{% block body %}
    <!-- ENTÊTE DE SECTION CLINIQUE -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Index des Produits</h1>
            <p class="text-lg text-zinc-500 mt-1">Configuration et accès direct aux fiches techniques de valorisation matière.</p>
        </div>
        <a href="{{ path('app_product_new') }}" class="inline-flex items-center justify-center gap-2 px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span>Créer un produit</span>
        </a>
    </div>

    <!-- TABLEAU TECHNIQUE DES PRODUITS -->
    <div class="bg-white border border-zinc-200 rounded-md overflow-hidden">
        <table class="table w-full text-xs">
            <thead>
            <tr class="bg-zinc-50 border-b border-zinc-200 text-zinc-500 uppercase tracking-wider text-[10px] font-semibold">
                <th class="py-3 px-4 text-left w-20">ID</th>
                <th class="py-3 px-4 text-left">Nom de la matière / produit</th>
                <th class="py-3 px-4 text-right">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100">
            {% for product in products %}
                <tr class="hover:bg-zinc-50/50 transition-colors">
                    <td class="py-3.5 px-4 font-mono text-zinc-400">
                        #{{ product.id }}
                    </td>
                    <td class="py-3.5 px-4 font-bold text-zinc-900 uppercase tracking-tight text-sm">
                        {{ product.name }}
                    </td>
                    <td class="py-3.5 px-4 text-right">
                        <div class="inline-flex items-center gap-2">
                            <a href="{{ path('app_product_show', {'id': product.id}) }}" class="inline-flex items-center justify-center px-2.5 py-1 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
                                Détail
                            </a>
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="inline-flex items-center justify-center px-2.5 py-1 border border-transparent bg-zinc-100 text-zinc-700 hover:bg-zinc-200 font-medium rounded-md text-xs transition-colors">
                                Modifier
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <!-- ÉTAT VIDE TECHNIQUE -->
                <tr>
                    <td colspan="3" class="text-center py-12 border-none">
                        <p class="text-xs font-medium text-zinc-400 italic">Aucun enregistrement trouvé dans la base de données.</p>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
