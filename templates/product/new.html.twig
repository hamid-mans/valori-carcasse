{% extends 'base.html.twig' %}

{% block title %}Ajouter une Matière - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Ajouter une Matière</h1>
        <p class="text-lg text-zinc-500 mt-1">Créez un nouveau produit dans le catalogue pour démarrer les analyses de coûts et de valorisation.</p>
    </div>

    <div class="bg-white border border-zinc-200 rounded-md p-6 max-w-xl">

        {{ include('product/_form.html.twig') }}

        <div class="mt-6 pt-4 border-t border-zinc-100 flex justify-start">
            <a href="{{ path('app_home') }}" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
                Annuler et retourner au catalogue
            </a>
        </div>
    </div>
{% endblock %}
