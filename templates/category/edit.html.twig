{% extends 'base.html.twig' %}

{% block title %}Modifier Catégorie{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto bg-zinc-900 border border-zinc-800 p-6 rounded-lg">
        <h1 class="text-2xl font-bold text-white mb-4">Modifier la Catégorie</h1>

        {{ form_start(form) }}
        <div class="mb-4">
            {{ form_row(form.name) }}
        </div>
        <div class="flex justify-between items-center mt-6">
            <a href="{{ path('app_home') }}" class="text-xs text-zinc-400 hover:text-white">Annuler</a>
            <button type="submit" class="px-4 py-2 bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-medium rounded-md text-xs">Mettre à jour</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
