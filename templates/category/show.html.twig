{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    {# Fil d'ariane & En-tête #}
    <div class="mb-6 flex justify-between items-center">
        <div>
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-1 text-xs text-zinc-500 hover:text-zinc-900 mb-2 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
                Retour aux catégories
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900 uppercase">
                {{ category.name }}
            </h1>
        </div>

        <a href="{{ path('app_product_new') }}" class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Nouveau produit
        </a>
    </div>

    {# Liste des produits #}
    <div class="bg-white border border-zinc-200 rounded-md overflow-hidden shadow-sm">
        <div class="p-4 border-b border-zinc-100 flex justify-between items-center bg-zinc-50/50">
            <h2 class="font-bold uppercase text-xs tracking-wider text-zinc-800">
                Produits enregistrés
            </h2>
            <span class="font-mono text-[10px] bg-white border border-zinc-200 px-2 py-0.5 rounded text-zinc-600 font-medium">
                Total : {{ products|length }}
            </span>
        </div>

        <div class="divide-y divide-zinc-100">
            {% for product in products|sort((a, b) => a.name <=> b.name) %}
                <div class="p-4 flex items-center justify-between hover:bg-zinc-50/80 transition-colors group">
                    <div class="flex items-center gap-3">
                        <div>
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="font-semibold text-sm text-zinc-900 uppercase tracking-tight hover:underline block">
                                {{ product.name }}
                            </a>
                            <span class="text-[11px] text-zinc-400 font-mono">
                                {{ product.processuses|length }} session(s) / processus
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        {# Action 1 : Gérer le produit, ses processus et étapes #}
                        <a href="{{ path('app_product_show', {id: product.id}) }}" class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded text-xs transition-colors inline-flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-3.5 h-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 18H7.5m9-6h2.25m-2.25 0a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 12h8.25" />
                            </svg>
                            Gérer
                        </a>

                        {# Action 2 : Vue Dashboard #}
                        <a href="{{ path('app_dashboard', {category_id: category.id, product_id: product.id}) }}" class="px-3 py-1.5 border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-700 font-medium rounded text-xs transition-colors inline-flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-3.5 h-3.5 text-zinc-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                            </svg>
                            Dashboard
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="p-8 text-center text-xs text-zinc-500">
                    Aucun produit associé à cette catégorie pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
