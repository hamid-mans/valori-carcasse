{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

<!-- LIBELLÉ DE L'ÉTAPE -->
<div class="space-y-1">
    <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">
        Libellé de l'étape / Flux
    </label>
    {{ form_widget(form.name, {
        'attr': {
            'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs text-zinc-900 font-medium placeholder-zinc-400 focus:outline-none focus:border-zinc-400 transition-colors',
            'placeholder': 'Ex: Transport amont, Abattage, Taxe sanitaire...'
        }
    }) }}
    {% if form_errors(form.name) %}
        <div class="text-rose-600 text-[11px] font-medium mt-1">
            {{ form_errors(form.name) }}
        </div>
    {% endif %}
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- MONTANT FINANCIER -->
    <div class="space-y-1">
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">
            Montant (€)
        </label>
        {{ form_widget(form.amout, {
            'attr': {
                'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-mono font-semibold text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors',
                'placeholder': '0.00'
            }
        }) }}
        {% if form_errors(form.amout) %}
            <div class="text-rose-600 text-[11px] font-medium mt-1">
                {{ form_errors(form.amout) }}
            </div>
        {% endif %}
    </div>

    <!-- NATURE DU FLUX (GAIN VS CHARGE) -->
    <div class="space-y-1">
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">
            Nature du flux
        </label>
        <div class="relative">
            {{ form_widget(form.isGain, {
                'attr': {
                    'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors appearance-none'
                }
            }) }}
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-zinc-400">
                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M7 10l5 5 5-5H7z"/>
                </svg>
            </div>
        </div>
        {% if form_errors(form.isGain) %}
            <div class="text-rose-600 text-[11px] font-medium mt-1">
                {{ form_errors(form.isGain) }}
            </div>
        {% endif %}
    </div>
</div>

<!-- NOTE / DESCRIPTION COMPLÉMENTAIRE SI ELLE EXISTE -->
{% if form.description is defined %}
    <div class="space-y-1">
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">
            Notes complémentaires
        </label>
        {{ form_widget(form.description, {
            'attr': {
                'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-400 transition-colors rows-2',
                'placeholder': 'Précisions sur le calcul du coût ou de la valorisation...'
            }
        }) }}
    </div>
{% endif %}

<!-- BOUTON ENREGISTRER UNIQUE -->
<button type="submit" class="inline-flex items-center justify-center w-full px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors mt-2">
    {{ button_label|default('Enregistrer la ligne de flux') }}
</button>

{{ form_end(form) }}