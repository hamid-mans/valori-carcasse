{% extends 'base.html.twig' %}

{% block title %}Nouvelle Étape Financière - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto my-4">
        <div class="mb-6">
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Ajouter un Flux Financier</h1>
            <p class="text-xs text-zinc-500 mt-1">Modélisation précise d'une charge structurelle, logistique ou d'un gain de valorisation.</p>
        </div>

        <div class="bg-white border border-zinc-200 rounded-md p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Type de flux</label>
                <div class="relative">
                    {{ form_widget(form.isGain, {
                        'attr': {'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors appearance-none'}
                    }) }}
                </div>
            </div>

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Nature de la ligne</label>
                <div class="relative">
                    {{ form_widget(form.typeFrais, {
                        'attr': {'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors appearance-none'}
                    }) }}
                </div>
            </div>

            <div id="zone_carburant" class="p-4 bg-zinc-50 border border-zinc-200 rounded-md space-y-3 hidden">
                <div class="space-y-1">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400">1. Type de carburant</label>
                    <div class="relative">
                        {{ form_widget(form.carburantType, {
                            'attr': {'class': 'w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors appearance-none'}
                        }) }}
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400">2. Volume nécessaire (en Litres)</label>
                    <input type="number" id="carburant_litres" value="50" class="w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-mono font-bold text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors">
                </div>

                <div id="api_status" class="text-[11px] text-zinc-500 font-mono flex flex-col gap-1 px-1 min-h-[18px]"></div>
            </div>

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Désignation / Libellé</label>
                {{ form_widget(form.name, {
                    'attr': {'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors', 'placeholder': 'Ex: Transport amont, Équarrissage...'}
                }) }}
            </div>

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Montant de la ligne (€)</label>
                {{ form_widget(form.amout, {
                    'attr': {'class': 'w-full px-3 py-2 bg-white border border-zinc-200 rounded-md text-xs font-mono font-bold text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors', 'placeholder': '0.00'}
                }) }}
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-zinc-100 mt-6">
                <a href="{{ path('app_dashboard') }}" class="inline-flex items-center justify-center px-3 py-2 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
                    Annuler
                </a>
                <button type="submit" class="inline-flex items-center justify-center px-3 py-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
                    Valider et Enregistrer
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>

    <script>
        document.addEventListener('turbo:load', function() {
            const selectTypeFrais = document.querySelector('[id$="typeFrais"]') || document.getElementById('select_type_frais');
            const selectCarburant = document.querySelector('[id$="carburantType"]') || document.getElementById('select_carburant');
            const zoneCarburant = document.getElementById('zone_carburant');
            const inputLitres = document.getElementById('carburant_litres');
            const inputAmount = document.querySelector('[id$="amout"]') || document.querySelector('[id$="amount"]') || document.getElementById('step_amount');
            const inputName = document.querySelector('[id$="name"]') || document.getElementById('step_name');
            const apiStatus = document.getElementById('api_status');

            const prixSecours = {
                'Gazole': 1.68,
                'SP95': 1.76,
                'SP98': 1.85
            };

            let prixLitreApplique = 0;

            function calculerEtRemplir() {
                if (prixLitreApplique > 0 && inputAmount && inputName && selectCarburant) {
                    const litres = parseFloat(inputLitres.value) || 0;
                    const total = prixLitreApplique * litres;

                    inputAmount.value = total.toFixed(2);
                    inputName.value = `Frais logistiques - Carburant ${selectCarburant.value} (${litres}L)`;
                }
            }

            if (selectTypeFrais && zoneCarburant) {
                selectTypeFrais.addEventListener('change', function() {
                    if (this.value === 'carburant') {
                        zoneCarburant.classList.remove('hidden');
                        if (inputName && (!inputName.value || inputName.value === "")) {
                            inputName.value = "Acheminement logistique - Carburant";
                        }
                    } else {
                        zoneCarburant.classList.add('hidden');
                        if (selectCarburant) selectCarburant.value = '';
                        prixLitreApplique = 0;
                        if (apiStatus) apiStatus.innerHTML = '';
                    }
                });

                if (selectTypeFrais.value === 'carburant') {
                    zoneCarburant.classList.remove('hidden');
                }
            }

            if (selectCarburant) {
                selectCarburant.addEventListener('change', async function() {
                    const carburant = this.value;
                    if (!carburant) {
                        prixLitreApplique = 0;
                        if (apiStatus) apiStatus.innerHTML = '';
                        return;
                    }

                    prixLitreApplique = prixSecours[carburant] || 0;
                    if (apiStatus) {
                        apiStatus.innerHTML = `<span>Application du cours estimé : <strong>${prixLitreApplique.toFixed(2)} €/L</strong>. Synchronisation...</span>`;
                    }
                    calculerEtRemplir();

                    try {
                        const apiTarget = encodeURIComponent(`https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-temps-reel/records?where=cp%20like%20%2275*%22&limit=50`);
                        const response = await fetch(`https://api.allorigins.win/get?url=${apiTarget}`);
                        if (!response.ok) throw new Error("Réseau KO");

                        const wrapper = await response.json();
                        const data = JSON.parse(wrapper.contents);

                        if (data.results && data.results.length > 0) {
                            let somme = 0;
                            let count = 0;

                            data.results.forEach(station => {
                                if (station.prix) {
                                    try {
                                        const liste = JSON.parse(station.prix.replace(/'/g, '"'));
                                        liste.forEach(item => {
                                            if (item['@nom'] === carburant) {
                                                somme += parseFloat(item['@valeur']);
                                                count++;
                                            }
                                        });
                                    } catch (e) {}
                                }
                            });

                            if (count > 0 && apiStatus) {
                                prixLitreApplique = somme / count;
                                apiStatus.innerHTML = `<span class="text-emerald-600 font-bold">✔</span> Connecté à l'API nationale : Prix moyen constaté : <strong>${prixLitreApplique.toFixed(3)} €/L</strong>`;
                                calculerEtRemplir();
                            }
                        }
                    } catch (err) {
                        if (apiStatus) {
                            apiStatus.innerHTML = `<span class="text-amber-600 font-bold">⚠</span> Flux direct indisponible. Indexation de secours préservée : <strong>${prixLitreApplique.toFixed(2)} €/L</strong>`;
                        }
                    }
                });
            }

            if (inputLitres) {
                inputLitres.addEventListener('input', calculerEtRemplir);
            }
        });
    </script>
{% endblock %}