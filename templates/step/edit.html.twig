{% extends 'base.html.twig' %}

{% block title %}Modifier l'étape #{{ step.id }} - Valori-Carcasse{% endblock %}

{% block body %}
    <!-- ENTÊTE DE MODIFICATION CLINIQUE -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Modifier l'étape <span class="font-mono text-zinc-400">#{{ step.id }}</span></h1>
        <p class="text-xs text-zinc-500 mt-1">Ajustez les paramètres financiers, les montants ou la nature de cet élément analytique.</p>
    </div>

    <!-- CONTENEUR DU FORMULAIRE STYLE SHADCN -->
    <div class="bg-white border border-zinc-200 rounded-md p-6 max-w-xl mb-6">
        <h2 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400 mb-4 border-b border-zinc-100 pb-2">Formulaire de mise à jour</h2>

        <!-- Inclusion du formulaire éclaté et stylisé -->
        {{ include('step/_form.html.twig', {'button_label': 'Mettre à jour l\'étape'}) }}

        <!-- BARRE D'ACTION SECONDAIRE EN BAS -->
        <div class="mt-6 pt-4 border-t border-zinc-100 flex justify-start">
            <a href="{{ path('app_step_index') }}" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50 font-medium rounded-md text-xs transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
                Annuler et retourner au journal
            </a>
        </div>
    </div>

    <!-- PANNEAU DE SÉCURITÉ / SUPPRESSION -->
    <div class="max-w-xl bg-zinc-50 border border-zinc-200 rounded-md p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="space-y-0.5">
            <p class="text-xs font-semibold text-zinc-900">Zone de danger</p>
            <p class="text-[11px] text-zinc-400">Cette action supprimera définitivement le flux comptable de l'application.</p>
        </div>
        <div class="w-full sm:w-auto text-right">
            {{ include('step/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}