{% extends 'base.html.twig' %}

{% block title %}Reporting Temporel - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Reporting & Analyse Temporelle</h1>
            <p class="text-xs text-zinc-500 mt-1">Suivez les cycles de valorisation et analysez la saisonnalité de vos marges d'exploitation.</p>
        </div>
        <span class="inline-block font-mono text-[10px] font-bold text-zinc-600 bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded tracking-wider uppercase">
            Module Évolution
        </span>
    </div>

    <div class="bg-white border border-zinc-200 rounded-md p-5 mb-6">
        <form method="get" action="{{ path('app_reporting') }}" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-end w-full">

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">Matière / Produit</label>
                <select name="product_id" class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-semibold text-zinc-900 focus:outline-none focus:border-zinc-400 transition-colors">
                    {% for p in products %}
                        <option value="{{ p.id }}" {% if selectedProduct and selectedProduct.id == p.id %}selected{% endif %}>
                            {{ p.name|upper }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">Date de début</label>
                <input type="date" name="date_debut" value="{{ dateDebut }}" class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 font-mono focus:outline-none focus:border-zinc-400 transition-colors">
            </div>

            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">Date de fin</label>
                <input type="date" name="date_fin" value="{{ dateFin }}" class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 font-mono focus:outline-none focus:border-zinc-400 transition-colors">
            </div>

            <div>
                <button type="submit" class="inline-flex items-center justify-center w-full px-4 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
                    Filtrer la période
                </button>
            </div>
        </form>
    </div>

    {% if selectedProduct and processusPeriod is not empty %}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <div class="bg-white border border-zinc-200 rounded-md p-5">
                <div class="border-b border-zinc-100 pb-2 mb-4">
                    <h3 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400">Évolution chronologique de la rentabilité nette</h3>
                    <p class="text-[10px] text-zinc-400 mt-0.5">Courbe de tendance du solde final par session d'équarrissage</p>
                </div>
                <div class="h-72">
                    <canvas id="timelineChart"></canvas>
                </div>
            </div>

            <div class="bg-white border border-zinc-200 rounded-md p-5">
                <div class="border-b border-zinc-100 pb-2 mb-4">
                    <h3 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400">Analyse de structure : Coûts vs Coproduits</h3>
                    <p class="text-[10px] text-zinc-400 mt-0.5">Répartition volume des gains (positif) et charges (négatif)</p>
                </div>
                <div class="h-72">
                    <canvas id="structureChart"></canvas>
                </div>
            </div>

        </div>

        <script>
            document.addEventListener('turbo:load', function() {
                const ctxTimeline = document.getElementById('timelineChart');
                const ctxStructure = document.getElementById('structureChart');
                if (!ctxTimeline || !ctxStructure) return;

                const labels = [];
                const soldes = [];
                const gains = [];
                const costs = [];

                {% for processus in processusPeriod %}
                labels.push("{{ processus.createdAt|date('d/m/y') }} - {{ processus.name|e('js') }}");
                soldes.push({{ processus.soldeFinal }});
                gains.push({{ processus.gainsTotal }});
                costs.push(-{{ processus.costsTotal }});
                {% endfor %}

                // 1. RENDU DU GRAPH DE TENDANCE ÉPURÉ (LINE)
                new Chart(ctxTimeline.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Marge Nette (€)',
                            data: soldes,
                            borderColor: '#18181b', // Zinc Pur
                            backgroundColor: 'transparent',
                            fill: false,
                            tension: 0.15,
                            borderWidth: 2,
                            pointBackgroundColor: '#18181b',
                            pointRadius: 3,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#18181b',
                                titleFont: { size: 11, weight: '600' },
                                bodyFont: { size: 11, family: 'monospace' },
                                padding: 10,
                                borderRadius: 4
                            }
                        },
                        scales: {
                            y: {
                                ticks: { color: '#71717a', font: { size: 10, family: 'monospace' } },
                                grid: { color: '#f4f4f5' }
                            },
                            x: {
                                ticks: { maxRotation: 45, minRotation: 15, color: '#18181b', font: { size: 9, weight: '500' } },
                                grid: { display: false }
                            }
                        }
                    }
                });

                // 2. RENDU DU GRAPH DE STRUCTURE TECHNIQUE MAT (BARS MIROIR)
                new Chart(ctxStructure.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Valorisations (+)',
                                data: gains,
                                backgroundColor: '#cbd5e1', // Zinc clair mat
                                borderRadius: 0
                            },
                            {
                                label: 'Charges & Logistique (-)',
                                data: costs,
                                backgroundColor: '#e11d48', // Rose destructif mat
                                borderRadius: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: '#18181b', boxWidth: 12, font: { size: 10, weight: '500' } }
                            },
                            tooltip: {
                                backgroundColor: '#18181b',
                                titleFont: { size: 11, weight: '600' },
                                bodyFont: { size: 11, family: 'monospace' },
                                padding: 10,
                                borderRadius: 4
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                ticks: { maxRotation: 45, minRotation: 15, color: '#18181b', font: { size: 9, weight: '500' } },
                                grid: { display: false }
                            },
                            y: {
                                stacked: true,
                                ticks: { color: '#71717a', font: { size: 10, family: 'monospace' } },
                                grid: { color: '#f4f4f5' }
                            }
                        }
                    }
                });
            });
        </script>

    {% else %}
        <div class="flex flex-col items-center justify-center text-center py-16 bg-white border border-zinc-200 rounded-md">
            <div class="p-3 bg-zinc-50 rounded-full border border-zinc-100 text-zinc-400 mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <p class="text-xs font-semibold text-zinc-800">Aucune activité enregistrée sur cette période</p>
            <p class="text-[11px] text-zinc-400 mt-1 max-w-sm leading-relaxed">Modifiez la plage de dates ou sélectionnez un autre type de carcasse animale pour actualiser les graphiques analytiques.</p>
        </div>
    {% endif %}
{% endblock %}