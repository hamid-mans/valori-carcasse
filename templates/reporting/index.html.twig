{% extends 'base.html.twig' %}

{% block title %}Reporting Analytique Produits - Valori-Carcasse{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Analyse Stratégique du Portefeuille</h1>
            <p class="text-xs text-zinc-500 mt-1">Performances commerciales et financières consolidées par catégorie de matières.</p>
        </div>
        <span class="inline-block font-mono text-[10px] font-bold text-zinc-600 bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded tracking-wider uppercase">
            Analyse Catalogue
        </span>
    </div>

    {# Filtres #}
    <div class="bg-white border border-zinc-200 rounded-md p-5 mb-6">
        <form method="get" action="{{ path('app_reporting') }}" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end w-full">
            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">Date de début</label>
                <input type="date" name="date_debut" value="{{ dateDebut }}" class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 font-mono focus:outline-none focus:border-zinc-400 transition-colors">
            </div>
            <div class="space-y-1">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">Date de fin</label>
                <input type="date" name="date_fin" value="{{ dateFin }}" class="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-md text-xs font-medium text-zinc-900 font-mono focus:outline-none focus:border-zinc-400 transition-colors">
            </div>
            <div>
                <button type="submit" class="w-full px-4 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white font-medium rounded-md text-xs transition-colors">
                    Actualiser l'analyse
                </button>
            </div>
        </form>
    </div>

    {% if hasData %}
        {# KPIs Globaux #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white border border-zinc-200 rounded-md p-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Chiffre d'Affaires Global</span>
                <div class="text-xl font-bold text-zinc-900 mt-1">{{ globalGainsTotal|number_format(2, ',', ' ') }} €</div>
            </div>
            <div class="bg-white border border-zinc-200 rounded-md p-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Marge Brute Consolide</span>
                <div class="text-xl font-bold text-emerald-600 mt-1">{{ globalSoldeTotal|number_format(2, ',', ' ') }} €</div>
            </div>
            <div class="bg-white border border-zinc-200 rounded-md p-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Taux de Marge Moyen</span>
                <div class="text-xl font-bold text-zinc-900 mt-1">
                    {{ globalGainsTotal > 0 ? ((globalSoldeTotal / globalGainsTotal) * 100)|number_format(1) : 0 }} %
                </div>
            </div>
        </div>

        {# Graphiques de répartition #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            {# Répartition du CA (Doughnut) #}
            <div class="bg-white border border-zinc-200 rounded-md p-5 lg:col-span-1">
                <div class="border-b border-zinc-100 pb-2 mb-4">
                    <h3 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400">Mix Matières (% du CA)</h3>
                </div>
                <div class="h-64 flex items-center justify-center">
                    <canvas id="productMixChart"></canvas>
                </div>
            </div>

            {# Comparatif Rentabilité (Barres) #}
            <div class="bg-white border border-zinc-200 rounded-md p-5 lg:col-span-2">
                <div class="border-b border-zinc-100 pb-2 mb-4">
                    <h3 class="font-bold text-[10px] uppercase tracking-widest text-zinc-400">Rentabilité Comparative par Catégorie</h3>
                </div>
                <div class="h-64">
                    <canvas id="productCompareChart"></canvas>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('turbo:load', function() {
                const ctxMix = document.getElementById('productMixChart');
                const ctxCompare = document.getElementById('productCompareChart');
                if (!ctxMix || !ctxCompare) return;

                const labels = [];
                const gains = [];
                classicsSoldes = [];
                const costs = [];

                {% for stat in productStats %}
                labels.push("{{ stat.name|e('js') }}");
                gains.push({{ stat.gains }});
                classicsSoldes.push({{ stat.solde }});
                costs.push({{ stat.costs }});
                {% endfor %}

                // Graph 1 : Mix Matière (Doughnut)
                new Chart(ctxMix, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: gains,
                            backgroundColor: ['#18181b', '#71717a', '#e4e4e7'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } }
                    }
                });

                // Graph 2 : Comparatif Marge / Coûts (Bar)
                new Chart(ctxCompare, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'Marge Nette', data: classicsSoldes, backgroundColor: '#10b981' },
                            { label: 'Coûts Totaux', data: costs, backgroundColor: '#ef4444' }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { grid: { color: '#f4f4f5' }, ticks: { font: { size: 10 } } },
                            x: { grid: { display: false } }
                        },
                        plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } } }
                    }
                });
            });
        </script>
    {% else %}
        <div class="text-center py-16 bg-white border border-zinc-200 rounded-md">
            <p class="text-xs font-semibold text-zinc-800">Aucune donnée pour cette période.</p>
        </div>
    {% endif %}
{% endblock %}