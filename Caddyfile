# Caddyfile
# Remplace par ton vrai nom de domaine (Caddy gérera le SSL Let's Encrypt tout seul)
:80 {
    root * /app/public
    encode gzip zstd

# Exécute l'application Symfony via FrankenPHP
    php_server

# Gestion des fichiers statiques directement
    file_server

    log {
            output file /var/log/caddy_access.log
        }
}